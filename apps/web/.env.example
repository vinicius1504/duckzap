# para onde o front encaminha /api/* (a API pode estar em outra VPS)
API_INTERNAL_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Tempo real (WebSocket do apps/realtime). Opcional.
# Desenvolvimento: se vazio, usa ws://<host da página>:4001/ws.
# Produção: se vazio, usa wss://<mesmo host da página>/ws (o proxy reverso encaminha /ws para o serviço de tempo real).
# Se apontar para OUTRO host, a origem dele entra no connect-src da CSP. Variável pública: vai para o navegador, sem segredo.
# É lida na hora do build (NEXT_PUBLIC_*): mudou, rebuild.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws
