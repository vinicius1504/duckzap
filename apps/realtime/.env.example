# Servidor de tempo real (WebSocket). Sem segredos aqui: copie para .env e preencha a senha do Valkey.

REALTIME_PORT=4001
# 0.0.0.0 para container; 127.0.0.1 se o proxy (Caddy) roda na mesma máquina
REALTIME_HOST=0.0.0.0

# Valkey/Redis onde a API publica os eventos (canal rt:org:<id da empresa>). Local: porta 6380 do docker-compose.
REDIS_URL=redis://:<VALKEY_PASSWORD>@127.0.0.1:6380

# Endereço da API visto por este servidor (rede interna). Usado só para GET /v1/me com o cookie do navegador.
API_INTERNAL_URL=http://127.0.0.1:4000

# Origens do front aceitas no WebSocket (mesma lista do WEB_ORIGINS da API), separadas por vírgula, sem barra final.
# A primeira também é enviada como Origin à API.
WEB_ORIGINS=http://localhost:3000

# true SOMENTE atrás de proxy confiável (Caddy) que define X-Forwarded-For; usa o último item como IP do cliente.
# REALTIME_TRUST_PROXY=false

# Limites opcionais (valores padrão abaixo)
# REALTIME_MAX_CONNECTIONS_PER_USER=10
# REALTIME_MAX_CONNECTIONS_PER_IP=50
# REALTIME_MAX_MESSAGE_BYTES=1024
# REALTIME_CLIENT_MESSAGES_PER_10S=20
# REALTIME_PING_INTERVAL_MS=25000
# REALTIME_PONG_TIMEOUT_MS=60000
# REALTIME_REVALIDATE_INTERVAL_MS=300000
# REALTIME_AUTH_TIMEOUT_MS=5000
