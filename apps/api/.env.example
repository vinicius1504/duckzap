NODE_ENV=development
PORT=4000
# papel do app, SEM BYPASSRLS (criado por `pnpm --filter @duckzap/db db:roles`)
DATABASE_URL=postgres://duckzap_app:<APP_DB_PASSWORD>@127.0.0.1:5433/duckzap
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pela qual o navegador chega na API (proxy /api do front)
PUBLIC_API_URL=http://localhost:3000/api
WEB_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
SMTP_URL=smtp://127.0.0.1:1026

# IA: provedor trocável (anthropic | openai | gemini | fake). Sem chave, use fake.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL_SMART=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# openssl rand -base64 32 (cifra de segredos de integração)
ENCRYPTION_KEY=

# ── Painel Super Admin (/v1/admin/*) ──
# papel duckzap_admin (BYPASSRLS, privilégios mínimos; criado por `pnpm --filter @duckzap/db db:roles` com ADMIN_DB_PASSWORD)
ADMIN_DATABASE_URL=postgres://duckzap_admin:<ADMIN_DB_PASSWORD>@127.0.0.1:5433/duckzap
# origens do painel (checagem de Origin nas rotas de escrita)
ADMIN_ORIGINS=http://localhost:3002
# lista de IPs/CIDRs permitidos (vazio = qualquer IP). Ex.: 177.12.40.0/24,203.0.113.7
ADMIN_IP_ALLOWLIST=
# true só se a API está atrás de proxy confiável que acrescenta o IP real ao FIM de x-forwarded-for
ADMIN_TRUST_PROXY=false
# o segredo TOTP dos admins é cifrado com ENCRYPTION_KEY (acima)

# --- Canais (modules/channels/config.ts) ---
# Evolution API (provedor QR). Chave global = AUTHENTICATION_API_KEY do container.
EVOLUTION_URL=http://localhost:8081
EVOLUTION_API_KEY=
# Base pública da API para a Meta chamar (padrão: PUBLIC_API_URL)
PUBLIC_WEBHOOK_BASE_URL=
# Base da API vista de dentro do container da Evolution (dev: http://host.docker.internal:4000)
EVOLUTION_WEBHOOK_BASE_URL=
# Segredo do app Meta da plataforma (assinatura X-Hub-Signature-256 dos webhooks)
META_APP_SECRET=
META_GRAPH_URL=https://graph.facebook.com/v21.0

# Agentes de IA (modules/agents/config.ts)
# testes do simulador por minuto, por empresa (cada teste gasta tokens quando ha provedor)
AGENTS_SIMULATOR_PER_MINUTE=20
# geracoes de perfil do agente por minuto, por empresa (cada uma gasta milhares de tokens)
AGENTS_GENERATOR_PER_MINUTE=5
# dominios que o agente pode citar alem dos presentes no conhecimento (separados por virgula)
AGENTS_URL_ALLOWLIST=
# tamanho alvo (caracteres) de cada trecho de conhecimento
AGENTS_CHUNK_CHARS=900
# IA: LLM_PROVIDER/LLM_FALLBACK_PROVIDER = anthropic|openai|gemini|groq|fake e LLM_TIMEOUT_MS=30000 (ver packages/ai/src/registry.ts)

# Conversas (modules/conversations/config.ts)
# espera (ms) por novas mensagens do cliente antes de a IA responder (rajada) e teto contado do início da rajada
CONVERSATIONS_BURST_WINDOW_MS=5000
CONVERSATIONS_BURST_MAX_WAIT_MS=15000
# turnos de IA por conversa por minuto (anti-loop) e sugestões manuais por pessoa por minuto
CONVERSATIONS_AI_TURNS_PER_MINUTE=12
CONVERSATIONS_SUGGESTIONS_PER_MINUTE=10
# varredura de respostas de IA vencidas e encerramento por inatividade (ms; 0 desliga). Um worker/BullMQ a substitui.
CONVERSATIONS_SWEEP_INTERVAL_MS=30000
# cliente que escreve até N dias depois de a conversa ser resolvida reabre a mesma conversa (0 = sempre abre outra)
CONVERSATIONS_REOPEN_WINDOW_DAYS=7

# --- Campanhas (apps/api/src/modules/campaigns/config.ts) ---
# "off" (padrão): o envio roda no futuro apps/worker (runCampaignTick). "inline": a própria API varre campanhas vencidas
# em memória (só dev/demo; o estado está no banco, reiniciar não perde nada). Nunca ligue em produção sem o worker.
CAMPAIGNS_SCHEDULER=off
CAMPAIGNS_SWEEP_SECONDS=15
# Gerações de variação por IA por minuto por empresa (custo do LLM).
CAMPAIGNS_VARIATIONS_PER_MINUTE=6

# --- Autenticação e segurança (apps/api/src/middleware/security-config.ts) ---
# 2FA obrigatório para Proprietário/Administrador (§5.1): sem ele o resto da API responde 403 two_factor_required
# (/v1/me, /v1/onboarding e /v1/account continuam abertos para configurar). Padrão: true em produção, false em dev/test.
REQUIRE_2FA_FOR_ADMINS=false
# true SOMENTE atrás de proxy confiável (Caddy/Nginx, e o front quando ele repassa o IP) que acrescenta o IP real ao FIM
# de x-forwarded-for. Com false, x-forwarded-for é ignorado (limites de tentativa usam o socket). Em produção, atrás de proxy: true.
TRUST_PROXY=false
# Painel admin: exige o código de ativação no 1º acesso (ver docs/runbooks/primeiro-admin.md). Padrão: true em produção.
ADMIN_REQUIRE_ACTIVATION_CODE=false

# --- Boot, e-mail, ajuda e chaves (src/env.ts, lib/crypto.ts, modules/help) ---
# A API NÃO sobe com ENCRYPTION_KEY ausente/inválida (32 bytes em base64), nem com LLM_PROVIDER desconhecido.
# Rotação de chave: ENCRYPTION_KEYS="k2:<base64>,k1:<base64>" (a PRIMEIRA cifra, as demais só decifram; mantenha
# ENCRYPTION_KEY com a chave antiga enquanto houver valores no formato v1). Gere cada chave com: openssl rand -base64 32
ENCRYPTION_KEYS=
# remetente dos e-mails (convites, redefinição de senha, chamados)
MAIL_FROM=DuckChat <nao-responda@duckchat.local>
# para onde vão os chamados da Ajuda (vazio em dev = só registra o protocolo em log; em produção, defina)
SUPPORT_EMAIL=
# /openapi.json exige sessão; "true" libera para todos (só dev/documentação)
OPENAPI_PUBLIC=false
# IA de reserva e tempo limite por chamada (ver packages/ai/src/registry.ts). LLM_PROVIDER=fake é recusado em produção.
# LLM_FALLBACK_PROVIDER=gemini
# LLM_TIMEOUT_MS=30000
# Esforço de raciocínio do Claude (low|medium|high). Menos raciocínio = menos tokens = mais barato. Padrão: roteador low, resposta medium.
# LLM_EFFORT_FAST=low
# LLM_EFFORT_SMART=low
# Gerador de perfil do agente (tarefa rara, qualidade primeiro): modelo e esforço próprios. Vazio = usa LLM_MODEL_SMART; esforço padrão medium.
# LLM_MODEL_BEST=claude-sonnet-5-5
# LLM_EFFORT_BEST=medium

# --- Tempo real (src/lib/realtime.ts, contrato em packages/contracts/src/realtime.ts) ---
# A API PUBLICA avisos (só ids, nunca texto/nome/telefone) no Valkey/Redis, no canal rt:org:<id da empresa>; o servidor
# apps/realtime os repassa aos navegadores. Opcional: sem REDIS_URL a API funciona normalmente, só não publica
# (um aviso no boot) e as telas deixam de atualizar sozinhas. Falha do Valkey nunca derruba nem atrasa uma requisição.
# Forma (dev, Valkey do docker-compose.local.yml na porta 6380): redis://:<VALKEY_PASSWORD>@127.0.0.1:6380
# Se a senha tiver caracteres especiais, codifique-a (encodeURIComponent). Em produção use rediss:// (TLS). NUNCA commite a senha.
REDIS_URL=

# --- "Digitando…" no WhatsApp por QR (Evolution API; src/modules/channels/config.ts, providers/evolution.ts) ---
# true (padrão): mostra "digitando…" ao cliente (respostas da IA, campanhas e atendente digitando na tela, via o recurso
# nativo da Evolution: `delay` no envio e POST /chat/sendPresence) e recebe o "cliente digitando…" (evento PRESENCE_UPDATE
# do webhook, só avisa a tela em tempo real: nada é gravado). false desliga os DOIS lados: a capacidade `presence` some,
# nenhum envio leva `delay`, a rota POST /v1/conversations/:id/typing vira 204 sem chamar o provedor e o webhook ignora o evento.
PRESENCE_ENABLED=true
# true (padrão): ~30 s depois de subir (e a cada 24 h) reaplica o webhook com PRESENCE_UPDATE nas instâncias QR já conectadas
# (criadas antes deste recurso). Consulta antes de escrever, então repetir é inofensivo. Só vale com PRESENCE_ENABLED=true.
PRESENCE_WEBHOOK_SYNC=true

# --- Mídia: imagens, documentos e áudios das conversas (src/lib/storage.ts, modules/media) ---
# Armazenamento S3-compatível: Cloudflare R2 em produção, MinIO no desenvolvimento (docker-compose.local.yml, porta 9002).
# Sem ENDPOINT, BUCKET e as duas chaves o recurso fica DESLIGADO (anexar/receber arquivo responde "armazenamento não configurado")
# e o resto da API segue normal. O navegador envia e lê o arquivo DIRETO nas URLs assinadas (nada é público); nunca registre chaves.
# API S3. R2: https://<id-da-conta>.r2.cloudflarestorage.com · MinIO local: http://localhost:9002 (ou http://minio:9000 de dentro do Docker)
MEDIA_STORAGE_ENDPOINT=http://localhost:9002
# Opcional: host que o NAVEGADOR usa nas URLs assinadas quando o interno é outro (ex.: ENDPOINT=http://minio:9000 e PUBLIC=http://localhost:9002).
MEDIA_STORAGE_PUBLIC_ENDPOINT=
# R2: auto · S3/MinIO: a região do bucket (MinIO aceita qualquer uma)
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_BUCKET=duckzap-media
# MinIO local: MINIO_ROOT_USER / MINIO_ROOT_PASSWORD do docker-compose.local.yml (padrões duckzap / duckzap-dev-minio, SÓ para dev).
# R2: token de API do R2 com permissão de leitura e escrita SÓ neste bucket.
MEDIA_STORAGE_ACCESS_KEY_ID=duckzap
MEDIA_STORAGE_SECRET_ACCESS_KEY=duckzap-dev-minio
# true para MinIO (endereço /bucket/chave); R2 funciona com false
MEDIA_STORAGE_FORCE_PATH_STYLE=true
# Como o arquivo chega ao WhatsApp (só provedor QR/Evolution; a API oficial da Meta sempre usa URL):
#   auto (padrão)  URL assinada quando o armazenamento é https e público; senão base64 (a API lê o arquivo e envia o conteúdo)
#   url            sempre URL assinada (exige armazenamento https alcançável pela Evolution)
#   base64         sempre base64 (funciona sem URL pública; usa mais memória da API)
MEDIA_SEND_MODE=auto
