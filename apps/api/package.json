{
  "name": "@duckzap/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "vitest run",
    "llm:smoke": "tsx --env-file-if-exists=.env scripts/llm-smoke.ts",
    "whatsapp:smoke": "tsx --env-file-if-exists=.env scripts/whatsapp-contacts-smoke.ts",
    "eval:comprehension": "tsx --env-file-if-exists=.env scripts/eval-comprehension.ts",
    "eval:scheduling": "tsx --env-file-if-exists=.env scripts/eval-scheduling.ts",
    "generate:sample": "tsx --env-file-if-exists=.env scripts/generate-agent-sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@duckzap/ai": "workspace:*",
    "@duckzap/brand": "workspace:*",
    "@duckzap/contracts": "workspace:*",
    "@duckzap/db": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "ioredis": "5.11.1",
    "nodemailer": "10.2.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@duckzap/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "auth": "1.7.14",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
