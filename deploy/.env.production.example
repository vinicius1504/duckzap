# ═══════════════════════════════════════════════════════════════════════════════════════════════════════
# DuckChat — variáveis de PRODUÇÃO (lidas pelo deploy/docker-compose.prod.yml)
#
# Como usar (na VPS):   cd /opt/duckchat/deploy && cp .env.production.example .env && chmod 600 .env
#                        edite o .env, depois:  ./check-env.sh   (recusa subir com valor faltando ou de exemplo)
#
# REGRAS
#  - Nenhum valor abaixo é real. Tudo que começa com TROQUE_ É SÓ MARCADOR: o check-env.sh bloqueia o deploy se sobrar.
#  - O .env NUNCA vai para o Git nem para uma imagem. Guarde uma cópia no gerenciador de senhas (veja ENCRYPTION_KEY).
#  - Segredos de DESENVOLVIMENTO não podem ser reaproveitados aqui: gere todos de novo.
#  - Senhas de banco/Valkey/Evolution: só letras e números (openssl rand -hex). Caracteres como @ : / # $ quebram as URLs.
#  - Variáveis marcadas [BUILD] não ficam aqui: são variáveis do GitHub (ver deploy.md). IMAGE_TAG é posta pelo ./deploy.sh.
# ═══════════════════════════════════════════════════════════════════════════════════════════════════════


# ── 1. Domínios, HTTPS e imagens ─────────────────────────────────────────────────────────────────────────
# Domínio do app das empresas e do painel super admin (DNS na Cloudflare, com proxy ligado).
APP_DOMAIN=app.TROQUE-seudominio.com.br
ADMIN_DOMAIN=admin.TROQUE-seudominio.com.br
# E-mail para avisos do certificado (Let's Encrypt). Um e-mail seu de verdade.
ACME_EMAIL=TROQUE@seudominio.com.br
# origin = certificado de origem da Cloudflare em deploy/certs/origin.pem e origin.key (recomendado, Full strict).
# auto   = o Caddy emite o certificado sozinho (exige porta 80 alcançável pela Cloudflare no primeiro pedido).
TLS_MODE=origin
# cloudflare = o Caddy só atende IPs da Cloudflare (recomendado; o site TEM de passar pelo proxy da Cloudflare).
# off        = sem bloqueio por IP (testes, ou DNS "só DNS" sem proxy).
ORIGIN_LOCK=cloudflare
# Onde ficam as imagens do CI (GHCR): ghcr.io/<usuário-ou-organização-do-GitHub, minúsculo>
IMAGE_REGISTRY=ghcr.io/TROQUE-usuario-github
# Tamanho máximo de um pedido (opcional; padrão 32MB: planilha de 10 MB em base64 + mídia de até 20 MB)
# MAX_BODY_SIZE=32MB
# Fuso dos horários do backup (opcional)
# TZ=America/Sao_Paulo


# ── 2. Banco de dados e Valkey (só rede interna; NUNCA expostos) ────────────────────────────────────────────
# Gere CADA um com:  openssl rand -hex 24      (quatro valores DIFERENTES entre si)
# Dono do Postgres (migrations). Só vale na 1ª criação do volume: depois trocar exige ALTER ROLE (ver deploy.md).
POSTGRES_PASSWORD=TROQUE_openssl_rand_hex_24
# Papel da API (sem BYPASSRLS, isolamento por empresa). Criado/atualizado a cada deploy pelo serviço "migrate".
APP_DB_PASSWORD=TROQUE_openssl_rand_hex_24
# Papel do painel admin (BYPASSRLS, privilégios mínimos). Idem.
ADMIN_DB_PASSWORD=TROQUE_openssl_rand_hex_24
# Usuário "evolution" do banco da Evolution API. Só vale na 1ª criação do volume.
EVOLUTION_DB_PASSWORD=TROQUE_openssl_rand_hex_24
# Senha do Valkey (filas, tempo real, cache da Evolution)
VALKEY_PASSWORD=TROQUE_openssl_rand_hex_24
# Chave global da Evolution API (a API do DuckChat a usa para criar instâncias de WhatsApp)
EVOLUTION_API_KEY=TROQUE_openssl_rand_hex_24


# ── 3. Aplicação (API) ───────────────────────────────────────────────────────────────────────────────────
# Segredo de sessões/cookies (Better Auth), 64 caracteres:  openssl rand -hex 32
# Trocar invalida todas as sessões abertas.
BETTER_AUTH_SECRET=TROQUE_openssl_rand_hex_32
# Chave que CIFRA segredos guardados (credenciais de canais, TOTP dos admins), 32 bytes em base64:  openssl rand -base64 32
# ATENÇÃO MÁXIMA: se esta chave se perder, esses dados NÃO têm como ser recuperados (nem do backup).
# Guarde-a no gerenciador de senhas SEPARADA do servidor. Para trocar com segurança use ENCRYPTION_KEYS (rotação).
ENCRYPTION_KEY=TROQUE_openssl_rand_base64_32
# Rotação (opcional): "k2:<base64>,k1:<base64>" — a PRIMEIRA cifra, as demais só decifram. Veja apps/api/.env.example.
# ENCRYPTION_KEYS=
# 2FA obrigatório para dono/administrador das empresas e código de ativação no 1º login do painel. Deixe true.
REQUIRE_2FA_FOR_ADMINS=true
ADMIN_REQUIRE_ACTIVATION_CODE=true
# Só estes IPs/CIDRs acessam o painel admin na API (vazio = qualquer IP). Recomendado preencher com o(s) seu(s) IP(s).
# Ex.: 203.0.113.7,198.51.100.0/24
# ADMIN_IP_ALLOWLIST=
# Quem dispara os envios das campanhas. "inline" = a própria API (ainda não existe o worker dedicado). Não mude sem o worker.
# CAMPAIGNS_SCHEDULER=inline


# ── 4. IA ────────────────────────────────────────────────────────────────────────────────────────────────
# Em produção o provedor "fake" é recusado. Use anthropic (padrão do produto).
LLM_PROVIDER=anthropic
# Chave da API da Anthropic (console.anthropic.com), com limite de gasto configurado lá. Começa com sk-ant-.
LLM_API_KEY=TROQUE_chave_anthropic
# Modelos e esforço (opcionais; os padrões do código valem se ficarem comentados)
# LLM_MODEL_SMART=claude-sonnet-5-5
# LLM_MODEL_FAST=claude-haiku-5-5
# LLM_MODEL_BEST=claude-sonnet-5-5
# LLM_EFFORT_FAST=low
# LLM_EFFORT_SMART=low
# LLM_EFFORT_BEST=medium
# LLM_TIMEOUT_MS=30000
# IA de reserva se a principal cair (opcional)
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL_FAST=
# LLM_FALLBACK_MODEL_SMART=
# LLM_FALLBACK_MODEL_BEST=


# ── 5. E-mail (convites, redefinição de senha, chamados) ────────────────────────────────────────────────────
# SMTP REAL do seu provedor (Amazon SES, Resend, Brevo, Mailgun…). O Mailpit é só de desenvolvimento e é recusado aqui.
# Formato:  smtps://USUARIO:SENHA@smtp.seuprovedor.com:465   (use smtp://…:587 se for STARTTLS)
# Se a senha tiver caracteres especiais, codifique-os (%40 para @, etc.).
SMTP_URL=smtps://TROQUE:TROQUE@smtp.TROQUE-provedor.com:465
# Remetente: um endereço do SEU domínio com SPF/DKIM/DMARC configurados no provedor
MAIL_FROM=DuckChat <nao-responda@TROQUE-seudominio.com.br>
# Para onde vão os chamados da tela Ajuda. Obrigatório em produção.
SUPPORT_EMAIL=suporte@TROQUE-seudominio.com.br


# ── 6. WhatsApp ──────────────────────────────────────────────────────────────────────────────────────────
# Canal por QR code: usa a Evolution API do compose (nada a configurar além de EVOLUTION_API_KEY acima).
# WhatsApp oficial (Meta) — só se for usar o canal oficial:
# META_APP_SECRET=
# META_GRAPH_URL=https://graph.facebook.com/v21.0
# Base pública dos webhooks da Meta (padrão: https://APP_DOMAIN/api). Só mude se precisar.
# PUBLIC_WEBHOOK_BASE_URL=


# ── 7. Mídia no Cloudflare R2 (imagens, áudios e documentos das conversas) ─────────────────────────────────────
# Sem disco local: tudo vai para o R2. Crie um bucket PRIVADO e um token de API do R2 só com "Object Read & Write" nele.
# O NAVEGADOR envia (PUT) e lê o arquivo direto do R2 por URL assinada: esse tráfego NÃO passa pelo Caddy. Por isso:
#   1) o bucket precisa de CORS liberando PUT/GET/HEAD da origem do app (JSON de exemplo em docs/runbooks/deploy.md);
#   2) a CSP do web precisa liberar a origem do R2: o compose copia MEDIA_STORAGE_PUBLIC_ENDPOINT (ou, se vazio,
#      MEDIA_STORAGE_ENDPOINT) para o serviço web. Sem isso o envio falha com "Não foi possível enviar o arquivo".
# Tudo comentado = mídia desligada (a API sobe; o check-env.sh avisa). Preencheu UMA, preencha as OBRIGATÓRIAS:
# a API recusa subir em produção com a configuração pela metade.
# MEDIA_STORAGE_ENDPOINT=https://<ID_DA_CONTA>.r2.cloudflarestorage.com      (obrigatória)
# MEDIA_STORAGE_BUCKET=duckchat-media                                        (obrigatória)
# MEDIA_STORAGE_ACCESS_KEY_ID=                                               (obrigatória)
# MEDIA_STORAGE_SECRET_ACCESS_KEY=                                           (obrigatória)
# MEDIA_STORAGE_REGION=auto
# Use true com o R2: o endereço das URLs fica https://<conta>.r2.cloudflarestorage.com/<bucket>/..., cuja ORIGEM é a do
# endpoint (a mesma que a CSP libera). Com false o SDK usa https://<bucket>.<conta>.r2.cloudflarestorage.com e a origem muda.
# MEDIA_STORAGE_FORCE_PATH_STYLE=true
# Origem que o navegador vê nas URLs assinadas, se for diferente do endpoint (lista por vírgula). Vazio = a do endpoint.
# MEDIA_STORAGE_PUBLIC_ENDPOINT=
# Como a mídia chega ao WhatsApp por QR: auto | url | base64
# MEDIA_SEND_MODE=auto


# ── 8. Backup diário (serviço "backup": pg_dump → cifrado com age → Cloudflare R2) ────────────────────────────
# Chave PÚBLICA age. Gere o par FORA do servidor (age-keygen -o chave-backup.txt) e coloque aqui só a linha "age1…" da
# chave pública. A chave PRIVADA (AGE-SECRET-KEY-…) fica no gerenciador de senhas e num pen drive: sem ela o backup não abre.
BACKUP_AGE_RECIPIENT=TROQUE_age1_chave_publica
# Bucket SEPARADO do de mídia, com token próprio (Object Read & Write só nele). Ative também a regra de ciclo de vida do
# R2 para apagar objetos com mais de 30 dias (o script também apaga, mas duas travas são melhores que uma).
BACKUP_R2_ENDPOINT=https://TROQUE.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=TROQUE-duckchat-backups
BACKUP_R2_ACCESS_KEY_ID=TROQUE_r2_access_key_id
BACKUP_R2_SECRET_ACCESS_KEY=TROQUE_r2_secret_access_key
# Opcionais
# BACKUP_HOUR=03:30
# BACKUP_RETENTION_DAYS=30
# BACKUP_DATABASES=duckzap evolution
# Endereço de "heartbeat" (healthchecks.io / Better Stack): o backup avisa quando termina bem ou mal, e o serviço alerta
# você se o aviso não chegar. Recomendado.
# BACKUP_HEARTBEAT_URL=


# ── 9. Ajustes finos (todos opcionais; os padrões do código valem se ficarem comentados) ───────────────────────
# Veja apps/api/.env.example para o significado de cada um.
# AGENTS_SIMULATOR_PER_MINUTE=20
# AGENTS_GENERATOR_PER_MINUTE=5
# AGENTS_URL_ALLOWLIST=
# AGENTS_CHUNK_CHARS=900
# CONVERSATIONS_BURST_WINDOW_MS=5000
# CONVERSATIONS_BURST_MAX_WAIT_MS=15000
# CONVERSATIONS_AI_TURNS_PER_MINUTE=12
# CONVERSATIONS_SUGGESTIONS_PER_MINUTE=10
# CONVERSATIONS_SWEEP_INTERVAL_MS=30000
# CONVERSATIONS_REOPEN_WINDOW_DAYS=7
# CAMPAIGNS_SWEEP_SECONDS=15
# CAMPAIGNS_VARIATIONS_PER_MINUTE=6
# CHANNELS_QR_TTL_SECONDS=
# CHANNELS_SEND_PER_SECOND_QR=
# CHANNELS_SEND_BURST_QR=
# CHANNELS_SEND_PER_SECOND_OFFICIAL=
# CHANNELS_SEND_BURST_OFFICIAL=
# CHANNELS_WEBHOOK_PER_SECOND=
# CHANNELS_WEBHOOK_BURST=
# PRESENCE_ENABLED=true
# PRESENCE_WEBHOOK_SYNC=true
# BACKGROUND_JOBS=on
# INBOUND_REPROCESS_SECONDS=30
# INBOUND_PURGE_HOURS=24
# INBOUND_RETENTION_DAYS=30
# SUSPENSION_SWEEP_MINUTES=15
# Portas do Caddy no host (só para testes locais; em produção são 80 e 443)
# HTTP_PORT=80
# HTTPS_PORT=443


# ── Variáveis de BUILD (não ficam aqui; configure em GitHub → Settings → Variables) ───────────────────────────
# NEXT_PUBLIC_REALTIME_URL   [BUILD do web]  vazio = wss://<mesmo host>/ws (o desenho padrão). Só preencha se o realtime
#                            ficar em outro host. Mudou = nova imagem do web.
# API_INTERNAL_URL           [BUILD do web]  já vale http://api:4000 (nome do serviço). Não precisa mexer.
