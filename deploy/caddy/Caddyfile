# Caddy do DuckChat: único serviço exposto (80/443). Hosts, e-mail ACME e limite de corpo vêm de variáveis de ambiente
# (ver docker-compose.prod.yml e .env.production.example). Estrutura de rotas, por domínio:
#   APP_DOMAIN   /ws                                   -> realtime:4001   (WebSocket; /health do realtime NÃO é exposto)
#                /api/v1/auth/*, /api/v1/me,
#                /api/v1/webhooks/wa/*                 -> api:4000        (tira o /api; só estas rotas, o resto da API é interno)
#                /agentes/gerar-perfil                 -> web:3000        (espera longa: até ~5 min)
#                tudo o mais                           -> web:3000
#   ADMIN_DOMAIN tudo                                  -> admin:3002
{
	email {$ACME_EMAIL}

	servers {
		# HTTP/3 não é necessário até a origem (a Cloudflare fala h2 com o navegador)
		protocols h1 h2

		# A Cloudflare é o único proxy confiável: só dele aceitamos CF-Connecting-IP como IP do cliente.
		# Lista de https://www.cloudflare.com/ips/ (confira de vez em quando; deploy/cloudflare-ips.sh imprime a atual).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Cabeçalhos de segurança de reserva. O "?" só define quando a aplicação NÃO mandou o dela: a CSP, o HSTS e o resto do
# web/admin continuam sendo os do Next (next.config.ts e proxy.ts), sem duplicar.
(security_headers) {
	header {
		-Server
		?Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		?Cross-Origin-Opener-Policy "same-origin"
	}
}

# O X-Forwarded-For que chega às aplicações é SEMPRE só o IP real do cliente (sobrescrito aqui). A API e o realtime, com
# TRUST_PROXY=true, usam o ÚLTIMO item da lista: se o Caddy apenas acrescentasse o IP, o "último" seria o da Cloudflare.
(upstream_headers) {
	header_up X-Forwarded-For {client_ip}
}

{$APP_DOMAIN} {
	import /etc/caddy/origin-lock/{$ORIGIN_LOCK}.caddy
	import /etc/caddy/tls/{$TLS_MODE}.caddy
	import security_headers
	encode zstd gzip

	# teto de corpo: planilha de contatos 10 MB (JSON/base64 vira ~13,4 MB; a API aceita até 15 MB) e mídia até 20 MB
	request_body {
		max_size {$MAX_BODY_SIZE}
	}

	# tempo real: conexões longas; o ping de 25 s do servidor mantém a Cloudflare (corta ociosas em ~100 s) de pé
	handle /ws {
		reverse_proxy realtime:4001 {
			import upstream_headers
			stream_close_delay 5m
		}
	}

	# Única superfície pública da API: autenticação, "quem sou eu" e webhooks do WhatsApp oficial (token + assinatura).
	# O Better Auth já espera o prefixo /api na URL pública (PUBLIC_API_URL) e a API não o recebe, por isso o strip_prefix.
	@api path /api/v1/auth/* /api/v1/me /api/v1/webhooks/wa/*
	handle @api {
		uri strip_prefix /api
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:4000 {
			import upstream_headers
		}
	}

	# Gerar perfil do agente leva ~20-25 s e chega a ~2 min+ (a API desiste em 270 s; o navegador em 290 s).
	# O Caddy espera até 330 s. ATENÇÃO: a Cloudflare corta em 100 s (erro 524) nos planos Free/Pro/Business; ver deploy.md.
	handle /agentes/gerar-perfil {
		reverse_proxy web:3000 {
			import upstream_headers
			transport http {
				read_timeout 330s
				response_header_timeout 330s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			import upstream_headers
		}
	}
}

{$ADMIN_DOMAIN} {
	import /etc/caddy/origin-lock/{$ORIGIN_LOCK}.caddy
	import /etc/caddy/tls/{$TLS_MODE}.caddy
	import security_headers
	encode zstd gzip

	# o painel só envia formulários pequenos (Server Actions limitadas a 1 MB no app)
	request_body {
		max_size 4MB
	}

	reverse_proxy admin:3002 {
		import upstream_headers
	}
}
